{
  "name": "telebothost-mcp",
  "version": "2.0.0",
  "description": "TeleBotHost Developer API MCP Server — Model Context Protocol server for the TeleBotHost Developer API, deployable on Vercel, Render, Railway, Fly.io, or any Node host.",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "start": "node --import tsx server.ts",
    "dev": "node --import tsx --watch server.ts",
    "typecheck": "tsc --noEmit",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "vercel --prod --yes"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vercel/node": "5.8.24",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "telebothost",
    "telegram-bot",
    "bot-hosting",
    "ai",
    "claude",
    "cursor",
    "vercel",
    "render"
  ],
  "license": "MIT",
  "homepage": "https://github.com/telebothost/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/telebothost/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/telebothost/mcp-server/issues"
  }
}
